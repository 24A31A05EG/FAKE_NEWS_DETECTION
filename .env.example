# ============================================================
# FAKE_NEWS_DETECTION - Environment Variables Template
# Copy this file to `.env` and fill in values only if needed.
# Never commit your real `.env` file to GitHub.
# ============================================================

# General application settings
APP_NAME=FAKE_NEWS_DETECTION
APP_ENV=development
LOG_LEVEL=INFO

# Streamlit server settings
STREAMLIT_SERVER_PORT=8501

# Optional external news / fact-check API keys for evidence retrieval
# Leave blank if using public RSS / trusted domain retrieval only.
NEWS_API_KEY=
FACT_CHECK_API_KEY=
